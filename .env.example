# Copy to .env and adjust. Every value shown here is the built-in default.

# --- indexing ---
RAG_CHUNK_TOKENS=180
RAG_CHUNK_OVERLAP_TOKENS=40

# --- retrieval ---
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RAG_RRF_K=60
RAG_MMR_LAMBDA=0.7

# --- providers ---
# embedder: "hashing" (deterministic, no downloads) or "sentence-transformer"
RAG_EMBEDDER=hashing
RAG_EMBEDDING_DIM=512
RAG_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# generator: "extractive" (deterministic, no API key) or "anthropic"
RAG_GENERATOR=extractive
RAG_ANTHROPIC_MODEL=claude-sonnet-4-5
RAG_MAX_ANSWER_TOKENS=700
# Required only when RAG_GENERATOR=anthropic. Never commit a real key.
# ANTHROPIC_API_KEY=

# --- serving ---
RAG_CORPUS_DIR=data/corpus
RAG_INDEX_DIR=data/index
RAG_MIN_GROUNDEDNESS=0.25
LOG_LEVEL=INFO
